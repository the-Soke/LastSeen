# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=lastseen_app
DB_PASSWORD=change_me_in_production
DB_NAME=lastseen
DB_POOL_LIMIT=4
DB_SSL=false
# DB_SSL_CA=/path/to/ca-cert.pem  # uncomment for managed DB

# ── Server ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000
AUTH_SECRET=change_me_auth_secret
DATA_ENCRYPTION_KEY=change_me_data_encryption_key
ENABLE_BACKGROUND_JOBS=true

# ── Web Push (VAPID) ──────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@lastseen.app

# ── Storage ───────────────────────────────────────────────────
# STORAGE_DRIVER=local  (default, saves to /uploads)
# STORAGE_DRIVER=s3
S3_REGION=us-east-1
S3_BUCKET=lastseen-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=         # Set for MinIO or Cloudflare R2
S3_PUBLIC_URL=       # CDN base URL

# ── SMS Gateway (Africa's Talking) ───────────────────────────
AT_API_KEY=
AT_USERNAME=sandbox  # Change to your username in production
# SMTP email (used for reporter AI score alerts >50)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
